# DynamoDB table name (must match Terraform output)
DYNAMODB_TABLE_NAME=sk-template-dev-responses

# AWS region where DynamoDB and Cognito is deployed
AWS_REGION=eu-west-2

# AWS Cognito User Pool ID for login
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX

# AWS Named profile (make sure to run this command before: 
# aws sso login --profile <profile>
AWS_PROFILE=your-aws-profile

# Local server port
PORT=3001

# CORS origins (comma-separated, * for all in dev)
ALLOWED_ORIGINS=*
