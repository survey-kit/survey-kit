{
  "id": "survey-kit-showcase",
  "title": "General form showcase",
  "description": "Demonstrates question types, validation, conditional visibility, branching, and layout behaviour. Content is generic and not tied to any particular data-collection topic.",
  "showQuestionNumbers": true,
  "navigation": {
    "stageOrder": "sequential",
    "groupOrder": "sequential",
    "pageOrder": "sequential"
  },
  "progress": {
    "showOverall": true,
    "showPerStage": false,
    "showPerGroup": false,
    "showPerPage": false,
    "location": ["header", "sidebar"]
  },
  "stages": [
    {
      "id": "stage-basics",
      "title": "Basics",
      "description": "Common field types and validation helpers",
      "icon": "FileText",
      "groups": [
        {
          "id": "group-inputs",
          "title": "Text and structured inputs",
          "description": "Uses the registry Input component for text-like types",
          "icon": "Type",
          "pages": [
            {
              "id": "page-primary-contact",
              "title": "Primary contact",
              "icon": "User",
              "description": "Text, email, number, and date fields with basic validation",
              "questions": [
                {
                  "id": "respondent_name",
                  "type": "text",
                  "label": "Display name",
                  "placeholder": "How should we refer to you?",
                  "required": true,
                  "requiredToNavigate": true,
                  "validation": [
                    {
                      "type": "min",
                      "value": 2,
                      "message": "Please enter at least 2 characters"
                    },
                    {
                      "type": "max",
                      "value": 80,
                      "message": "Please keep this under 80 characters"
                    }
                  ]
                },
                {
                  "id": "primary_email",
                  "type": "email",
                  "label": "Primary email",
                  "placeholder": "you@example.com",
                  "description": "Used for pattern validation (email input type)",
                  "required": true,
                  "requiredToNavigate": true,
                  "validation": [
                    {
                      "type": "pattern",
                      "value": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                      "message": "Enter a valid email address"
                    }
                  ]
                },
                {
                  "id": "team_size",
                  "type": "number",
                  "label": "Approximate team size",
                  "placeholder": "e.g. 12",
                  "required": false,
                  "description": "Optional numeric field"
                },
                {
                  "id": "review_date",
                  "type": "date",
                  "label": "Preferred follow-up date",
                  "required": false
                }
              ]
            },
            {
              "id": "page-narrative-cross-validation",
              "title": "Long text and cross-field rules",
              "icon": "AlignLeft",
              "questions": [
                {
                  "id": "context_notes",
                  "type": "textarea",
                  "label": "Additional context",
                  "placeholder": "Anything else we should know?",
                  "description": "Native textarea styling in the survey renderer",
                  "required": false
                },
                {
                  "id": "confirm_email",
                  "type": "email",
                  "label": "Confirm primary email",
                  "placeholder": "Re-enter the same email",
                  "required": true,
                  "requiredToNavigate": true,
                  "validation": [
                    {
                      "type": "crossQuestion",
                      "questionId": "primary_email",
                      "operator": "equals",
                      "message": "Must match the primary email above"
                    }
                  ]
                },
                {
                  "id": "window_start",
                  "type": "date",
                  "label": "Availability window start",
                  "required": true,
                  "requiredToNavigate": true
                },
                {
                  "id": "window_end",
                  "type": "date",
                  "label": "Availability window end",
                  "required": true,
                  "requiredToNavigate": true,
                  "validation": [
                    {
                      "type": "dateRange",
                      "questionId": "window_start",
                      "operator": "greaterThanOrEqual",
                      "message": "End date must be on or after the start date"
                    }
                  ]
                },
                {
                  "id": "budget_low",
                  "type": "number",
                  "label": "Budget range — lower bound (thousands)",
                  "required": true,
                  "requiredToNavigate": true
                },
                {
                  "id": "budget_high",
                  "type": "number",
                  "label": "Budget range — upper bound (thousands)",
                  "required": true,
                  "requiredToNavigate": true,
                  "validation": [
                    {
                      "type": "numberRange",
                      "questionId": "budget_low",
                      "operator": "greaterThanOrEqual",
                      "message": "Upper bound must be greater than or equal to the lower bound"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "group-choice-controls",
          "title": "Choice controls",
          "description": "Radio, checkbox, and select use registry Checkbox and SimpleDropdown",
          "icon": "ListChecks",
          "pages": [
            {
              "id": "page-single-and-multi",
              "title": "Selection patterns",
              "icon": "CircleDot",
              "questions": [
                {
                  "id": "preferred_channel",
                  "type": "radio",
                  "label": "Preferred contact channel",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Email", "value": "email" },
                    { "label": "Phone", "value": "phone" },
                    { "label": "In person", "value": "in_person" }
                  ]
                },
                {
                  "id": "interests",
                  "type": "checkbox",
                  "label": "Which topics should we include? (multi-select)",
                  "description": "Checkbox answers drive array-based conditions elsewhere",
                  "required": false,
                  "options": [
                    {
                      "label": "Documentation",
                      "value": "docs",
                      "description": "Unlocks an optional group later"
                    },
                    {
                      "label": "Training",
                      "value": "training"
                    },
                    {
                      "label": "Community events",
                      "value": "events"
                    }
                  ]
                },
                {
                  "id": "region",
                  "type": "select",
                  "label": "Region",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "North", "value": "north" },
                    { "label": "South", "value": "south" },
                    { "label": "East", "value": "east" },
                    { "label": "West", "value": "west" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "stage-sliders",
      "title": "Emoji sliders",
      "description": "Single and scale configurations for EmojiSlider",
      "icon": "Smile",
      "groups": [
        {
          "id": "group-emoji-fields",
          "title": "Sentiment controls",
          "icon": "SlidersHorizontal",
          "pages": [
            {
              "id": "page-emoji-single",
              "title": "Single-emoji slider",
              "questions": [
                {
                  "id": "mood_single",
                  "type": "emoji-slider",
                  "label": "Overall mood (single emoji track)",
                  "required": false,
                  "emojiSlider": {
                    "type": "single",
                    "emoji": "😊",
                    "min": 0,
                    "max": 100,
                    "step": 5
                  }
                }
              ]
            },
            {
              "id": "page-emoji-scale",
              "title": "Labeled scale",
              "questions": [
                {
                  "id": "mood_scale",
                  "type": "emoji-slider",
                  "label": "Agreement scale",
                  "description": "Scale type maps to multiple emoji positions",
                  "required": true,
                  "requiredToNavigate": true,
                  "emojiSlider": {
                    "type": "scale",
                    "scale": 5,
                    "showLabels": true,
                    "emojis": [
                      {
                        "value": 1,
                        "emoji": "😠",
                        "label": "Strongly disagree"
                      },
                      { "value": 2, "emoji": "🙁", "label": "Disagree" },
                      { "value": 3, "emoji": "😐", "label": "Neutral" },
                      { "value": 4, "emoji": "🙂", "label": "Agree" },
                      { "value": 5, "emoji": "😄", "label": "Strongly agree" }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "stage-question-conditionals",
      "title": "Question-level logic",
      "description": "Visibility with AND, OR, equals, and notEquals",
      "icon": "GitBranch",
      "groups": [
        {
          "id": "group-format-branching",
          "title": "Branching inputs",
          "pages": [
            {
              "id": "page-response-depth",
              "title": "How much detail?",
              "questions": [
                {
                  "id": "response_depth",
                  "type": "radio",
                  "label": "How detailed should the next questions be?",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Brief", "value": "brief" },
                    { "label": "Standard", "value": "standard" },
                    { "label": "In depth", "value": "deep" }
                  ]
                }
              ]
            },
            {
              "id": "page-follow-ups-format",
              "title": "Conditional follow-ups",
              "questions": [
                {
                  "id": "deep_dive_notes",
                  "type": "textarea",
                  "label": "In-depth explanation",
                  "description": "Shown only when you chose In depth",
                  "required": true,
                  "requiredToNavigate": true,
                  "conditional": {
                    "conditions": [
                      {
                        "questionId": "response_depth",
                        "operator": "equals",
                        "value": "deep"
                      }
                    ]
                  }
                },
                {
                  "id": "brief_or_standard_tip",
                  "type": "text",
                  "label": "Quick supplement",
                  "description": "Shown when depth is Brief OR Standard (OR logic)",
                  "placeholder": "Optional short note",
                  "required": false,
                  "conditional": {
                    "logic": "OR",
                    "conditions": [
                      {
                        "questionId": "response_depth",
                        "operator": "equals",
                        "value": "brief"
                      },
                      {
                        "questionId": "response_depth",
                        "operator": "equals",
                        "value": "standard"
                      }
                    ]
                  }
                },
                {
                  "id": "not_deep_comment",
                  "type": "text",
                  "label": "Anything to add when not using in-depth mode?",
                  "required": false,
                  "conditional": {
                    "conditions": [
                      {
                        "questionId": "response_depth",
                        "operator": "notEquals",
                        "value": "deep"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "page-two-part-triggers",
              "title": "Two-part trigger",
              "questions": [
                {
                  "id": "consent_followup_a",
                  "type": "radio",
                  "label": "May we contact you about outcomes?",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Yes", "value": "yes" },
                    { "label": "No", "value": "no" }
                  ]
                },
                {
                  "id": "consent_followup_b",
                  "type": "radio",
                  "label": "May we include anonymised quotes?",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Yes", "value": "yes" },
                    { "label": "No", "value": "no" }
                  ]
                }
              ]
            },
            {
              "id": "page-and-gate",
              "title": "Combined requirement",
              "questions": [
                {
                  "id": "dual_opt_in_detail",
                  "type": "textarea",
                  "label": "Tell us how to reach you for both follow-ups",
                  "description": "Visible only when both prior answers are Yes (AND)",
                  "required": true,
                  "requiredToNavigate": true,
                  "conditional": {
                    "logic": "AND",
                    "conditions": [
                      {
                        "questionId": "consent_followup_a",
                        "operator": "equals",
                        "value": "yes"
                      },
                      {
                        "questionId": "consent_followup_b",
                        "operator": "equals",
                        "value": "yes"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "stage-structure-and-navigation",
      "title": "Structure and navigation",
      "description": "Optional group, conditional page, skip logic, and static next routes",
      "icon": "Map",
      "groups": [
        {
          "id": "group-structure-preamble",
          "title": "Preamble",
          "pages": [
            {
              "id": "page-bonus-enrollment",
              "title": "Optional extension",
              "questions": [
                {
                  "id": "enroll_bonus_stage",
                  "type": "radio",
                  "label": "Would you like to complete a short extra stage at the end?",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Yes", "value": "yes" },
                    { "label": "No", "value": "no" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "group-docs-follow-up",
          "title": "Documentation path",
          "description": "Entire group is visible when Documentation was ticked earlier",
          "icon": "BookOpen",
          "conditional": {
            "conditions": [
              {
                "questionId": "interests",
                "operator": "equals",
                "value": "docs"
              }
            ]
          },
          "pages": [
            {
              "id": "page-doc-focus",
              "title": "Documentation preferences",
              "questions": [
                {
                  "id": "doc_format",
                  "type": "select",
                  "label": "Preferred reference format",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "PDF handbooks", "value": "pdf" },
                    { "label": "Web articles", "value": "web" },
                    { "label": "Video walkthroughs", "value": "video" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "group-page-visibility",
          "title": "Page visibility",
          "pages": [
            {
              "id": "page-region-gate",
              "title": "Region context",
              "description": "The next page is visible only if you chose East as your region in the Basics section.",
              "questions": [
                {
                  "id": "region_context_ack",
                  "type": "text",
                  "label": "Optional: notes that apply to any region",
                  "required": false
                }
              ]
            },
            {
              "id": "page-east-overlay",
              "title": "East region overlay",
              "description": "This page appears only when Region = East",
              "conditional": {
                "conditions": [
                  {
                    "questionId": "region",
                    "operator": "equals",
                    "value": "east"
                  }
                ]
              },
              "questions": [
                {
                  "id": "east_specific_note",
                  "type": "textarea",
                  "label": "Notes specific to the East region",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "id": "group-branching-demo",
          "title": "Skip and merge routes",
          "pages": [
            {
              "id": "page-branch-start",
              "title": "Branch start",
              "nextPageId": "page-branch-merge",
              "questions": [
                {
                  "id": "branch_intro",
                  "type": "radio",
                  "label": "This page uses nextPageId to jump ahead, skipping an intermediate page",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Continue with jump", "value": "jump" }
                  ]
                }
              ]
            },
            {
              "id": "page-branch-skipped",
              "title": "Skipped surface",
              "description": "You only see this if you navigated backwards or landed here directly",
              "questions": [
                {
                  "id": "skipped_page_marker",
                  "type": "text",
                  "label": "If you can read this, you reached the middle of the branch",
                  "required": false
                }
              ]
            },
            {
              "id": "page-branch-merge",
              "title": "Merge point",
              "questions": [
                {
                  "id": "merge_ack",
                  "type": "radio",
                  "label": "The prior page jumped straight here via nextPageId",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [{ "label": "Understood", "value": "ok" }]
                }
              ]
            },
            {
              "id": "page-skip-logic",
              "title": "Answer-triggered skip",
              "questions": [
                {
                  "id": "skip_middle_section",
                  "type": "radio",
                  "label": "Skip the very next page?",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [
                    { "label": "Stay on the full path", "value": "no" },
                    { "label": "Skip ahead", "value": "yes" }
                  ],
                  "skipLogic": {
                    "logic": "AND",
                    "conditions": [
                      {
                        "questionId": "skip_middle_section",
                        "operator": "equals",
                        "value": "yes"
                      }
                    ],
                    "nextPageId": "page-after-skip"
                  }
                }
              ]
            },
            {
              "id": "page-skip-middle",
              "title": "Middle hop",
              "description": "Bypassed when you choose Skip ahead",
              "questions": [
                {
                  "id": "middle_only_field",
                  "type": "text",
                  "label": "Only filled if you did not skip",
                  "required": false
                }
              ]
            },
            {
              "id": "page-after-skip",
              "title": "After the optional skip",
              "questions": [
                {
                  "id": "skip_flow_complete",
                  "type": "radio",
                  "label": "Navigation demo complete — continue to submission",
                  "required": true,
                  "requiredToNavigate": true,
                  "options": [{ "label": "Finish", "value": "done" }]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "stage-bonus",
      "title": "Extra stage",
      "description": "Stage-level conditional — only offered when you opted in earlier",
      "icon": "Sparkles",
      "conditional": {
        "conditions": [
          {
            "questionId": "enroll_bonus_stage",
            "operator": "equals",
            "value": "yes"
          }
        ]
      },
      "groups": [
        {
          "id": "group-bonus-only",
          "title": "Bonus prompts",
          "pages": [
            {
              "id": "page-bonus-feedback",
              "title": "Final thoughts",
              "questions": [
                {
                  "id": "bonus_reflection",
                  "type": "textarea",
                  "label": "What felt clearest or most useful in this flow?",
                  "required": false
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
